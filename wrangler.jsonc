{
  "name": "artgalzim",
  "main": "./worker.js",
  "compatibility_date": "2025-09-27",
  "routes": [
    { "pattern": "artgalzim.com/*", "zone_name": "artgalzim.com" },
    { "pattern": "www.artgalzim.com/*", "zone_name": "artgalzim.com" }
  ],
  "vars": {
    "SANITY_PROJECT_ID": "2a274c3r",
    "SANITY_DATASET": "production"
  },
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
