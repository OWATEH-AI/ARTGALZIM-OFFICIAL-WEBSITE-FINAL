# Copy this file to .env locally and fill in your real values.
# Do not commit the real .env file.

SANITY_PROJECT_ID=2a274c3r
SANITY_DATASET=production
SANITY_API_TOKEN=replace-with-sanity-write-token
ADMIN_PASSWORD=replace-with-strong-admin-password
ADMIN_SESSION_SECRET=replace-with-random-long-secret

# Optional local database settings if you use Neon/Postgres scripts
DATABASE_URL=replace-with-neon-pooled-url
DATABASE_URL_UNPOOLED=replace-with-neon-direct-url

# Sanity Studio settings
SANITY_STUDIO_PROJECT_ID=2a274c3r
SANITY_STUDIO_DATASET=production
